# Port for student backend API
PORT=10000

# MongoDB connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/student_attendance

# JWT signing secret (Must be at least 32 characters long)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# JWT expiration
JWT_EXPIRES_IN=1d

# Admin API Key for session creation (Must be at least 32 characters long)
ADMIN_API_KEY=replace-with-a-separate-long-random-key-at-least-32-chars

# Allowed client origins for CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173
